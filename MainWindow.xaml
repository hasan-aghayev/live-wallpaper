<Window x:Class="LiveWallpaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaS Live Wallpaper"
        Height="720" Width="860"
        MinHeight="640" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource UiBgBrush}"
        Foreground="{StaticResource UiTextBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="44,32,44,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="HaS Studio" FontSize="21" FontWeight="Bold"
                           Foreground="{StaticResource UiTextBrush}"/>
                <TextBlock Text="Live wallpaper" FontSize="12"
                           Foreground="{StaticResource UiTextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" x:Name="StatusBadge"
                    Background="{StaticResource UiSurfaceInsetBrush}"
                    BorderBrush="{StaticResource UiBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource UiRadiusSm}" Padding="14,9"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="{StaticResource UiTextMutedBrush}" Margin="0,0,9,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="12"
                               FontWeight="SemiBold" Foreground="{StaticResource UiTextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,18"
                      Padding="0,0,4,0">
            <StackPanel>
                <!-- Video -->
                <Border x:Name="DropZone"
                        Background="{StaticResource UiSurfaceInsetBrush}"
                        BorderBrush="{StaticResource UiBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource UiRadiusPanel}" Padding="30"
                        MinHeight="158" AllowDrop="True"
                        Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Add a video" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop a video here or choose a file"
                                   FontSize="12" Foreground="{StaticResource UiTextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,7,0,17"/>
                        <Button Content="Choose video" Style="{StaticResource UiButtonPrimary}"
                                Width="166" HorizontalAlignment="Center" Click="BtnBrowse_Click"/>
                    </StackPanel>
                </Border>

                <Grid Margin="4,16,4,0">
                    <StackPanel>
                        <TextBlock Text="VIDEO" FontSize="10" FontWeight="SemiBold"
                                   FontFamily="{StaticResource UiFontMono}"
                                   Foreground="{StaticResource UiTextMutedBrush}"/>
                        <TextBlock x:Name="TxtSelectedFileName" Text="No video selected"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource UiTextBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                        <TextBlock x:Name="TxtSelectedFilePath" Text="Choose a file to begin"
                                   FontSize="11" Foreground="{StaticResource UiTextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Main actions -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnApply" Grid.Column="0" Content="Apply wallpaper"
                            Style="{StaticResource UiButtonPrimary}" Margin="0,0,10,0"
                            Click="BtnApply_Click"/>
                    <Button x:Name="BtnPauseResume" Grid.Column="1" Content="Pause"
                            Width="112" Style="{StaticResource UiButtonSecondary}" Margin="0,0,10,0"
                            Click="BtnPauseResume_Click" IsEnabled="False"/>
                    <Button x:Name="BtnStop" Grid.Column="2" Content="Stop" Width="92"
                            Style="{StaticResource UiButtonDanger}"
                            Click="BtnStop_Click" IsEnabled="False"/>
                </Grid>

                <!-- Settings -->
                <Border Style="{StaticResource UiCard}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume" FontSize="12"
                                       Foreground="{StaticResource UiTextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <Slider x:Name="SliderVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                    Height="28" Foreground="{StaticResource UiAccentBrush}"
                                    VerticalAlignment="Center" ValueChanged="SliderVolume_ValueChanged"/>
                            <TextBlock x:Name="TxtVolumeValue" Grid.Column="2" Text="0%" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource UiAccentBrush}"
                                       Width="46" TextAlignment="Right" VerticalAlignment="Center"
                                       Margin="14,0,22,0"/>
                            <CheckBox x:Name="ChkMute" Grid.Column="3" Content="Mute" Style="{StaticResource UiCheckBox}"
                                      IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkMute_Changed" Unchecked="ChkMute_Changed"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Scaling" FontSize="12"
                                       Foreground="{StaticResource UiTextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <ComboBox x:Name="CmbStretch" Grid.Column="1" Width="280"
                                      HorizontalAlignment="Left" Style="{StaticResource UiComboBox}"
                                      SelectionChanged="CmbStretch_SelectionChanged">
                                <ComboBoxItem Content="Fill screen" IsSelected="True" Tag="Fill"/>
                                <ComboBoxItem Content="Fit to screen" Tag="Fit"/>
                                <ComboBoxItem Content="Stretch to fill" Tag="Stretch"/>
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{StaticResource UiBorderBrush}" Margin="0,22,0,0"/>

                        <Grid Margin="0,20,0,0">
                            <CheckBox x:Name="ChkEnableOverlay" Content="Desktop dimming"
                                      Style="{StaticResource UiCheckBox}"
                                      Checked="ChkEnableOverlay_Changed" Unchecked="ChkEnableOverlay_Changed"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Opacity" FontSize="12"
                                       Foreground="{StaticResource UiTextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <Slider x:Name="SliderOverlayOpacity" Grid.Column="1" Minimum="0" Maximum="90" Value="35"
                                    SmallChange="1" LargeChange="10" Height="28"
                                    Foreground="{StaticResource UiAccentBrush}"
                                    VerticalAlignment="Center" ValueChanged="SliderOverlayOpacity_ValueChanged"/>
                            <Border Grid.Column="2" Background="{StaticResource UiAccentSoftBrush}"
                                    BorderBrush="{StaticResource UiBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource UiRadiusXs}" Padding="10,5"
                                    Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOverlayOpacityValue" Text="35%" FontSize="12"
                                           FontWeight="SemiBold" FontFamily="{StaticResource UiFontMono}"
                                           Foreground="{StaticResource UiAccentBrush}" Width="38"
                                           TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <CheckBox x:Name="ChkAutoStart" Content="Start with Windows" Style="{StaticResource UiCheckBox}"
                                      Checked="ChkAutoStart_Checked" Unchecked="ChkAutoStart_Unchecked"/>
                            <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to tray" Style="{StaticResource UiCheckBox}"
                                      Margin="28,0,0,0"
                                      IsChecked="True" Checked="ChkMinimizeToTray_Changed" Unchecked="ChkMinimizeToTray_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtFooterMessage" Text="Ready"
                       FontSize="11" Foreground="{StaticResource UiTextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save settings" Style="{StaticResource UiButtonPrimary}"
                        MinWidth="126" Click="BtnSaveSettings_Click"/>
                <Button Content="Hide to tray" Style="{StaticResource UiButtonSecondary}"
                        Padding="16,0" Click="BtnMinimizeToTray_Click" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
